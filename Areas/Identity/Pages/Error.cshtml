@page
@model ErrorModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
}

<h1 class="text-danger">Đã xảy ra lỗi</h1>
<h2 class="text-danger">Không thể xử lý yêu cầu của bạn.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Mã yêu cầu:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>Chế độ phát triển</h3>
<p>
    Chuyển sang môi trường <strong>Development</strong> sẽ hiển thị thông tin chi tiết hơn về lỗi.
</p>
<p>
    <strong>Không bật môi trường Development trên ứng dụng đang triển khai</strong>, vì thông tin nhạy cảm từ ngoại lệ có thể bị hiển thị cho người dùng. Khi gỡ lỗi cục bộ, hãy đặt biến môi trường <strong>ASPNETCORE_ENVIRONMENT</strong> thành <strong>Development</strong> rồi khởi động lại ứng dụng.
</p>
