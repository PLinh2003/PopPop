@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Xác nhận đăng ký";
}

<h1>@ViewData["Title"]</h1>
@{
    if (@Model.DisplayConfirmAccountLink)
    {
<p>
    Hệ thống chưa cấu hình dịch vụ gửi email. Xem <a href="https://aka.ms/aspaccountconf">hướng dẫn cấu hình</a> để thiết lập.
    Liên kết xác nhận tài khoản: <a id="confirm-link" href="@Model.EmailConfirmationUrl">Xác nhận tài khoản</a>
</p>
    }
    else
    {
<p>
        Vui lòng kiểm tra email để xác nhận tài khoản.
</p>
    }
}

