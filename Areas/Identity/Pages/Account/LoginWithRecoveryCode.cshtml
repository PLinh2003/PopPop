@page
@model LoginWithRecoveryCodeModel
@{
    ViewData["Title"] = "Xác minh bằng mã khôi phục";
}

<h1>@ViewData["Title"]</h1>
<hr />
<p>
    Bạn đang đăng nhập bằng mã khôi phục. Thiết bị này sẽ chưa được ghi nhớ cho đến khi bạn đăng nhập bằng mã từ ứng dụng xác thực hoặc tắt xác thực hai bước rồi đăng nhập lại.
</p>
<div class="row">
    <div class="col-12">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="Nhập mã khôi phục" />
                <label asp-for="Input.RecoveryCode" class="form-label">Mã khôi phục</label>
                <span asp-validation-for="Input.RecoveryCode" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Đăng nhập</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
