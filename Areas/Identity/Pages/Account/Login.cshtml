@page
@model LoginModel

@{
    Layout = "_IdentityLayout";
    ViewData["Title"] = "Đăng nhập";
}

<section class="cl-login10">
    <header class="cl-login10__head">
        <img src="~/img/logo.png" alt="Logo">
    </header>

    <div class="cl-login10__panel">
        <form id="account" method="post" class="cl-login10__form" data-form="login">
            <h1 class="cl-login10__title">Đăng nhập</h1>

            <div class="cl-login10__field" data-field>
                <label asp-for="Input.Email" class="cl-login10__label"
                       for="cl-login10-l-email">
                    Email
                </label>

                <input asp-for="Input.Email"
                       class="cl-login10__input"
                       id="cl-login10-l-email"
                       type="email"
                       autocomplete="username"
                       required
                       data-msg="Vui lòng nhập email.">

                <p class="cl-login10__error"
                   id="cl-login10-l-email-err"
                   data-error></p>
            </div>

            <div class="cl-login10__field" data-field>
                <div class="cl-login10__row">
                    <label asp-for="Input.Password"
                           class="cl-login10__label"
                           for="cl-login10-l-pw">
                        Mật khẩu
                    </label>

                    <a asp-page="./ForgotPassword"
                       class="cl-login10__link">
                        Quên mật khẩu?
                    </a>
                </div>

                <div class="cl-login10__pw">
                    <input asp-for="Input.Password"
                           class="cl-login10__input"
                           id="cl-login10-l-pw"
                           type="password"
                           autocomplete="current-password"
                           required
                           minlength="8"
                           data-msg="Vui lòng nhập mật khẩu.">

                    <button class="cl-login10__eye"
                            type="button"
                            data-pw-toggle>
                        <svg class="cl-login10__eye-on"
                             viewBox="0 0 24 24"
                             width="20"
                             height="20"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>

                        <svg class="cl-login10__eye-off"
                             viewBox="0 0 24 24"
                             width="20"
                             height="20"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M3 3l18 18M10.6 5.1A10.8 10.8 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-3.2 4.1M6.6 6.6C3.9 8.3 2 12 2 12s3.6 7 10 7a9.8 9.8 0 0 0 5.4-1.6M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                        </svg>
                    </button>
                </div>

                <p class="cl-login10__error"
                   id="cl-login10-l-pw-err"
                   data-error></p>
            </div>

            <button class="cl-login10__submit" type="submit">
                Đăng nhập
            </button>

            <p class="cl-login10__swap">
                Bạn chưa có tài khoản?
                <a asp-page="./Register" class="cl-login10__link">
                    Tạo tài khoản
                </a>
            </p>
        </form>
    </div>

    <div class="cl-login10__done" data-success tabindex="-1" hidden>
        <span class="cl-login10__streak">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span>
        </span>

        <h2 class="cl-login10__title" data-done-title></h2>
        <p class="cl-login10__sub" data-done-text></p>

        <button class="cl-login10__swap-btn" type="button" data-reset>
            Quay lại
        </button>
    </div>

    <div class="cl-login10__vh"
         role="status"
         data-live></div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
