@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Tạo mã khôi phục xác thực hai bước";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Hãy lưu các mã này ở nơi an toàn.</strong>
    </p>
    <p>
        Nếu mất thiết bị và không còn mã khôi phục, bạn có thể mất quyền truy cập tài khoản.
    </p>
    <p>
        Tạo mã khôi phục mới không thay đổi khóa trong ứng dụng xác thực. Nếu muốn đổi khóa,
        hãy <a asp-page="./ResetAuthenticator">đặt lại khóa xác thực.</a>
    </p>
</div>
<div>
    <form method="post">
        <button class="btn btn-danger" type="submit">Tạo mã khôi phục mới</button>
    </form>
</div>
