@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = "Đặt lại khóa xác thực";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h3>@ViewData["Title"]</h3>
<div class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Sau khi đặt lại khóa, ứng dụng xác thực sẽ ngừng hoạt động cho đến khi được cấu hình lại.</strong>
    </p>
    <p>
        Thao tác này sẽ tắt xác thực hai bước cho đến khi bạn xác minh ứng dụng xác thực.
        Nếu không hoàn tất cấu hình, bạn có thể mất quyền truy cập tài khoản.
    </p>
</div>
<div>
    <form id="reset-authenticator-form" method="post">
        <button id="reset-authenticator-button" class="btn btn-danger" type="submit">Đặt lại khóa xác thực</button>
    </form>
</div>
