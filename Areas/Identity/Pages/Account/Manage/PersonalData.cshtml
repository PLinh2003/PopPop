@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dữ liệu cá nhân";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3>@ViewData["Title"]</h3>

<div class="row">
    <div class="col-12">
        <p>Tài khoản lưu trữ dữ liệu cá nhân bạn đã cung cấp. Tại đây, bạn có thể tải xuống hoặc xóa dữ liệu.</p>
        <p>
            <strong>Xóa dữ liệu sẽ đóng tài khoản vĩnh viễn và không thể khôi phục.</strong>
        </p>
        <form id="download-data" asp-page="DownloadPersonalData" method="post">
            <button class="btn btn-primary" type="submit">Tải dữ liệu</button>
        </form>
        <p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger">Xóa dữ liệu</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
