@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<h1>@ViewData["Title"]</h1>
<h2>Nhập địa chỉ email đã đăng ký</h2>
<hr />
<div class="row">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="ten@email.com" />
                <label asp-for="Input.Email" class="form-label">Địa chỉ email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Gửi yêu cầu đặt lại mật khẩu</button>
        </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
