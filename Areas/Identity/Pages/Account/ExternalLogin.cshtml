@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Hoàn tất đăng ký";
}

<h1>@ViewData["Title"]</h1>
<h2 id="external-login-title">Liên kết với tài khoản @Model.ProviderDisplayName</h2>
<hr />

<p id="external-login-description" class="text-info">
    Bạn đã xác thực thành công bằng <strong>@Model.ProviderDisplayName</strong>.
    Hãy nhập địa chỉ email để hoàn tất đăng ký và đăng nhập.
</p>

<div class="row">
    <div class="col-md-4">
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Nhập địa chỉ email của bạn"/>
                <label asp-for="Input.Email" class="form-label">Địa chỉ email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Hoàn tất đăng ký</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
