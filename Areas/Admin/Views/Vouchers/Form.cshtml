@model PopPop.Models.VoucherManagementFormViewModel
@using PopPop.Data.Entities.Enums
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Sửa voucher" : "Tạo voucher";
}
<div class="admin-page-heading"><div><h2>@ViewData["Title"]</h2><p>Mã voucher không cộng dồn với mã khác; giá trị giảm không vượt quá tiền hàng.</p></div><a class="btn btn-outline-secondary" asp-area="Admin" asp-controller="Vouchers" asp-action="Index">Quay lại</a></div>
<div class="admin-detail-card"><form asp-area="Admin" asp-controller="Vouchers" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3">
    <div class="col-md-4"><label asp-for="Code" class="form-label">Mã voucher</label><input asp-for="Code" class="form-control" maxlength="50" /><span asp-validation-for="Code" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="DiscountType" class="form-label">Loại giảm giá</label><select asp-for="DiscountType" class="form-select"><option value="@VoucherDiscountType.Percentage">Phần trăm</option><option value="@VoucherDiscountType.FixedAmount">Số tiền cố định</option></select></div>
    <div class="col-md-4"><label asp-for="DiscountValue" class="form-label">Giá trị giảm</label><input asp-for="DiscountValue" class="form-control" type="number" min="0.01" step="0.01" /><span asp-validation-for="DiscountValue" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="MinimumOrderAmount" class="form-label">Giá trị đơn tối thiểu</label><input asp-for="MinimumOrderAmount" class="form-control" type="number" min="0" step="1000" /></div>
    <div class="col-md-4"><label asp-for="MaximumDiscountAmount" class="form-label">Giảm tối đa (chỉ áp dụng %)</label><input asp-for="MaximumDiscountAmount" class="form-control" type="number" min="0.01" step="1000" /><span asp-validation-for="MaximumDiscountAmount" class="text-danger"></span></div>
    <div class="col-md-4"><label asp-for="MaximumUses" class="form-label">Số lượt dùng tối đa (để trống = không giới hạn)</label><input asp-for="MaximumUses" class="form-control" type="number" min="1" /><span asp-validation-for="MaximumUses" class="text-danger"></span></div>
    <div class="col-md-6"><label asp-for="StartsAt" class="form-label">Bắt đầu</label><input asp-for="StartsAt" class="form-control" type="datetime-local" /></div>
    <div class="col-md-6"><label asp-for="ExpiresAt" class="form-label">Kết thúc</label><input asp-for="ExpiresAt" class="form-control" type="datetime-local" /></div>
    <div class="col-12 form-check ms-2"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Kích hoạt voucher</label></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">@(editing ? "Lưu thay đổi" : "Tạo voucher")</button></div>
</div></form></div>
