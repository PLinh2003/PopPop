@model PopPop.Models.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
}

<section class="cart_area section_gap">
    <div class="container">
        <h2>Giỏ hàng</h2>

        @if (TempData["CartSuccess"] is string successMessage)
        {
            <div class="alert alert-success" role="alert">@successMessage</div>
        }
        @if (TempData["CartError"] is string errorMessage)
        {
            <div class="alert alert-danger" role="alert">@errorMessage</div>
        }

        @if (Model.Items.Count == 0)
        {
            <p>Giỏ hàng của bạn đang trống.</p>
            <a asp-controller="Home" asp-action="Index" class="primary-btn">Tiếp tục mua sắm</a>
        }
        else
        {
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Sản phẩm</th>
                            <th>SKU</th>
                            <th>Đơn giá</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <img src="@Url.Content(string.IsNullOrWhiteSpace(item.ImageUrl) ? "~/img/product/p1.jpg" : item.ImageUrl)"
                                         alt="@item.ProductName" width="70" />
                                    @item.ProductName
                                </td>
                                <td>@item.SKU</td>
                                <td>@item.UnitPrice.ToString("N0") ₫</td>
                                <td>
                                    <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.StockQuantity"
                                               class="form-control" style="max-width: 90px" aria-label="Số lượng @item.ProductName" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary ml-2" disabled="@(item.StockQuantity == 0)">Cập nhật</button>
                                    </form>
                                    @if (item.StockQuantity == 0)
                                    {
                                        <small class="text-danger">Sản phẩm hiện đã hết hàng.</small>
                                    }
                                    else if (item.Quantity > item.StockQuantity)
                                    {
                                        <small class="text-danger">Tồn kho hiện tại: @item.StockQuantity</small>
                                    }
                                </td>
                                <td>@item.LineTotal.ToString("N0") ₫</td>
                                <td>
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="cartItemId" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-right">
                <h4>Tổng tiền: @Model.TotalAmount.ToString("N0") ₫</h4>
                @if (Model.CanCheckout)
                {
                    <a asp-controller="Orders" asp-action="Checkout" class="primary-btn">Tiến hành đặt hàng</a>
                }
                else
                {
                    <p class="text-danger">Vui lòng cập nhật số lượng hoặc xóa sản phẩm không còn hàng trước khi đặt hàng.</p>
                }
            </div>
        }
    </div>
</section>
