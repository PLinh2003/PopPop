@using System.Security.Claims
@using PopPop.Services.Interfaces
@inject IHeaderBadgeService HeaderBadgeService

@{
    var cartQuantity = 0;
    var unreadChatCount = 0;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    if (!string.IsNullOrEmpty(currentUserId) && !User.IsInRole("Admin") && !User.IsInRole("Staff"))
    {
        var counts = await HeaderBadgeService.GetCountsAsync(currentUserId, Context.RequestAborted);
        cartQuantity = counts.CartQuantity;
        unreadChatCount = counts.UnreadChatCount;
    }

    ViewData["UnreadChatCount"] = unreadChatCount;
}

<header class="header_area store-header">
    <div class="main_menu">
        <nav class="navbar navbar-expand-lg navbar-light main_box">
            <div class="container">
                <a asp-controller="Home" asp-action="Index" class="navbar-brand logo_h" aria-label="PôpPôp - Trang chủ">
                    <img src="~/img/logo.png" alt="PôpPôp">
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Mở menu">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav store-header__links">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="shop">Cửa hàng</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contact">Liên hệ</a></li>
                    </ul>
                    <ul class="navbar-nav store-header__actions">
                        <li class="nav-item">
                            <button class="store-header__icon search" type="button" aria-label="Tìm kiếm sản phẩm">
                                <span class="lnr lnr-magnifier" id="search"></span>
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="store-header__icon store-header__notification" id="store-notifications" type="button"
                                    aria-label="Thông báo hỗ trợ" title="Thông báo">
                                <i class="fa fa-bell" aria-hidden="true"></i>
                                @if (unreadChatCount > 0)
                                {
                                    <span class="store-header__badge" aria-hidden="true">@(unreadChatCount > 99 ? "99+" : unreadChatCount.ToString())</span>
                                }
                            </button>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Cart" asp-action="Index" class="store-header__icon store-header__cart"
                               aria-label="Giỏ hàng, @cartQuantity sản phẩm">
                                <span class="ti-bag" aria-hidden="true"></span>
                                @if (cartQuantity > 0)
                                {
                                    <span class="store-header__badge" aria-hidden="true">@(cartQuantity > 99 ? "99+" : cartQuantity.ToString())</span>
                                }
                            </a>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </div>
    <div class="search_input" id="search_input_box" aria-live="polite">
        <div class="container search-panel">
            <div class="search-form">
                <input type="text" class="form-control" id="search_input" placeholder="Tìm sản phẩm bạn muốn..." autocomplete="off">
                <button type="button" class="btn btn-link search-clear" id="clear_search" aria-label="Xóa tìm kiếm">×</button>
                <span class="lnr lnr-cross" id="close_search" title="Đóng tìm kiếm" role="button" tabindex="0"></span>
            </div>
            <div id="search_results" class="search-results" hidden></div>
        </div>
    </div>
</header>
