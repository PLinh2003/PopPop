<!DOCTYPE html>
<html lang="vi" class="no-js">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="Tuan Vu">
    <meta name="description" content="PôpPôp - Cửa hàng chuyên cung cấp vợt cầu lông, giày cầu lông và phụ kiện thể thao chính hãng.">
    <meta name="keywords" content="PôpPôp, cửa hàng cầu lông, vợt cầu lông, giày cầu lông, phụ kiện cầu lông.">
    <link rel="icon" type="image/x-icon" href="~/img/fav.ico">
    <title>@ViewData["Title"] | PôpPôp</title>
    <partial name="_MainStylePartial" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <partial name="_HeaderPartial" />
    @RenderBody()
    <partial name="_FooterPartial" />
    <partial name="_MainScriptPartial" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
