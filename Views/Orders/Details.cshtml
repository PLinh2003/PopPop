@model PopPop.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var statusText = Model.Status switch
    {
        PopPop.Data.Entities.Enums.OrderStatus.Pending => "Chờ xác nhận",
        PopPop.Data.Entities.Enums.OrderStatus.Confirmed => "Đã xác nhận",
        PopPop.Data.Entities.Enums.OrderStatus.Processing => "Đang xử lý",
        PopPop.Data.Entities.Enums.OrderStatus.Shipping => "Đang giao hàng",
        PopPop.Data.Entities.Enums.OrderStatus.Completed => "Hoàn thành",
        PopPop.Data.Entities.Enums.OrderStatus.Cancelled => "Đã hủy",
        _ => Model.Status.ToString()
    };
}

<section class="section_gap">
    <div class="container">
        <div class="alert alert-success" role="status">
            Đặt hàng thành công. Mã đơn hàng: <strong>@Model.OrderCode</strong>
        </div>

        <div class="row">
            <div class="col-lg-6">
                <h4>Thông tin đơn hàng</h4>
                <p><strong>Trạng thái:</strong> @statusText</p>
                <p><strong>Ngày đặt:</strong> @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Người nhận:</strong> @Model.RecipientName</p>
                <p><strong>Số điện thoại:</strong> @Model.RecipientPhone</p>
                <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <p><strong>Ghi chú:</strong> @Model.Note</p>
                }
            </div>
            <div class="col-lg-6">
                <h4>Sản phẩm</h4>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName<br /><small>SKU: @item.SKU</small></td>
                                    <td>@item.UnitPrice.ToString("N0") ₫</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.LineTotal.ToString("N0") ₫</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Tạm tính</span>
                    <span>@Model.Items.Sum(item => item.LineTotal).ToString("N0") ₫</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Phí giao hàng</span>
                    <span>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} ₫")</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <strong>Tổng cộng</strong>
                    <strong>@Model.TotalAmount.ToString("N0") ₫</strong>
                </div>
            </div>
        </div>

        <a asp-controller="Home" asp-action="Index" class="primary-btn mt-4">Tiếp tục mua sắm</a>
    </div>
</section>
